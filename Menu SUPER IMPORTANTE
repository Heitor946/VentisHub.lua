-- ===== Helper: botão bevelado estilo Win95 =====
local function makeBevelButton(parent, size, pos)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = C.btnHi
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.ZIndex = 2
    btn.Parent = parent

    -- borda externa
    local s = Instance.new("UIStroke")
    s.Color = C.borderDark
    s.Thickness = 2
    s.Parent = btn

    -- bevel (topo/esquerda claro, baixo/direita escuro)
    local top = Instance.new("Frame")
    top.Size = UDim2.new(1, -4, 0, 1)
    top.Position = UDim2.new(0, 2, 0, 2)
    top.BackgroundColor3 = C.bevelHi
    top.BorderSizePixel = 0
    top.ZIndex = 3
    top.Parent = btn

    local left = Instance.new("Frame")
    left.Size = UDim2.new(0, 1, 1, -4)
    left.Position = UDim2.new(0, 2, 0, 2)
    left.BackgroundColor3 = C.bevelHi
    left.BorderSizePixel = 0
    left.ZIndex = 3
    left.Parent = btn

    local bottom = Instance.new("Frame")
    bottom.Size = UDim2.new(1, -4, 0, 1)
    bottom.Position = UDim2.new(0, 2, 1, -3)
    bottom.BackgroundColor3 = C.bevelLo
    bottom.BorderSizePixel = 0
    bottom.ZIndex = 3
    bottom.Parent = btn

    local right = Instance.new("Frame")
    right.Size = UDim2.new(0, 1, 1, -4)
    right.Position = UDim2.new(1, -3, 0, 2)
    right.BackgroundColor3 = C.bevelLo
    right.BorderSizePixel = 0
    right.ZIndex = 3
    right.Parent = btn

    -- label do texto (por cima)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = C.textDark
    label.Font = Enum.Font.Code
    label.TextSize = 15
    label.Text = ""
    label.ZIndex = 4
    label.Parent = btn

    -- feedback visual ao pressionar
    btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3 = C.btnPressed
        top.BackgroundColor3 = C.bevelLo
        left.BackgroundColor3 = C.bevelLo
        bottom.BackgroundColor3 = C.bevelHi
        right.BackgroundColor3 = C.bevelHi
    end)
    local function restore()
        btn.BackgroundColor3 = C.btnHi
        top.BackgroundColor3 = C.bevelHi
        left.BackgroundColor3 = C.bevelHi
        bottom.BackgroundColor3 = C.bevelLo
        right.BackgroundColor3 = C.bevelLo
    end
    btn.MouseButton1Up:Connect(restore)
    btn.MouseLeave:Connect(restore)

    return btn, label
end

-- ===== Botões dos scripts =====
for i, s in ipairs(SCRIPTS) do
    local y = 26 + (i - 1) * (BTN_H + BTN_GAP)
    local btn, label = makeBevelButton(
        Body,
        UDim2.new(1, -12, 0, BTN_H),
        UDim2.new(0, 6, 0, y)
    )
    label.Text = "▶ " .. s.nome

    local originalText = label.Text
    local loading = false

    btn.MouseButton1Click:Connect(function()
        if loading then return end
        loading = true

        label.Text = "⏳ Carregando..."
        Status.Text = "Carregando: " .. s.nome

        task.spawn(function()
            local ok, err = pcall(function()
                local src = game:HttpGet(s.url)
                local fn  = loadstring(src)
                if not fn then error("loadstring retornou nil") end
                fn()
            end)

            if ok then
                label.Text = "✔ " .. s.nome .. " [OK]"
                label.TextColor3 = C.greenLo
                Status.Text = s.nome .. " executado."
                Status.TextColor3 = C.green
            else
                label.Text = "✖ ERRO"
                label.TextColor3 = C.redLo
                Status.Text = "Erro: " .. tostring(err)
                Status.TextColor3 = Color3.fromRGB(255, 120, 120)
                warn("[Ventis Hub] " .. tostring(err))
            end

            task.wait(2)
            label.Text = originalText
            label.TextColor3 = C.textDark
            Status.Text = "Selecione um script:"
            Status.TextColor3 = C.yellow
            loading = false
        end)
    end)
end

-- ===== DRAG =====
do
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startPos

    local function isButton(gui)
        while gui and gui ~= Frame do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                return true
            end
            gui = gui.Parent
        end
        return false
    end

    local function begin(input)
        if isButton(input.Target) then return end
        dragging  = true
        dragStart = input.Position
        startPos  = Frame.Position
    end

    local function update(input)
        if not dragging then return end
        local d = input.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end

    for _, gui in ipairs({Frame, TitleBar, Title, TitleShadow}) do
        gui.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                begin(input)
            end
        end)
        gui.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                update(input)
            end
        end)
    end

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
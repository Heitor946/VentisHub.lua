-- ============================================================
-- ============ LOOP PRINCIPAL ================================
-- ============================================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local pulseT = 0

RunService.RenderStepped:Connect(function(dt)
    pulseT = pulseT + dt * 2.5
    local pulse = (math.sin(pulseT) + 1) * 0.5
    GlowStroke.Transparency = 0.4 + pulse * 0.4

    -- Spin + pulse do reticle ativo
    local active = reticles[currentReticle]
    if active then
        if active.pulse then active.pulse(pulse) end
        if active.spin then
            reticleAngle = reticleAngle + dt * 60
            active.spin(reticleAngle)
        end
    end

    if not LockOn or not Target then return end

    local char = Player.Character
    if not char then return end

    local head   = char:FindFirstChild("Head")
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    local hum    = char:FindFirstChildOfClass("Humanoid")
    local tRoot  = GetRoot(Target)
    local aimPos = GetAim(Target)

    if not (head and myRoot and hum and tRoot and aimPos) then
        SetTarget(FindNearest())
        if not Target then return end
        tRoot  = GetRoot(Target)
        aimPos = GetAim(Target)
        if not (tRoot and aimPos) then return end
    end

    local dist = (myRoot.Position - tRoot.Position).Magnitude
    if dist > MAX_DISTANCE then
        SetTarget(nil)
        return
    end

    hum.AutoRotate = false
    local flatAim = Vector3.new(aimPos.X, myRoot.Position.Y, aimPos.Z)
    if (flatAim - myRoot.Position).Magnitude > 0.05 then
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, flatAim)
    end

    -- Mira: escala com distância
    local scaleByDist = math.clamp(1 - (dist / MAX_DISTANCE) * 0.55, 0.45, 1)
    local baseSize = 130 * scaleByDist
    ReticleGui.Size = UDim2.new(0, baseSize, 0, baseSize)

    -- Câmera
    local desired
    if CameraDistance < 1 then
        desired = CFrame.lookAt(head.Position, aimPos)
    else
        local dir = myRoot.Position - tRoot.Position
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) else dir = dir.Unit end
        local offset = dir * CameraDistance + Vector3.new(0, TP_HEIGHT, 0)
        local origin = head.Position
        rayParams.FilterDescendantsInstances = { char, Target }
        local hit = workspace:Raycast(origin, offset, rayParams)
        local camPos = hit and (hit.Position + hit.Normal * 0.4) or (origin + offset)
        desired = CFrame.lookAt(camPos, aimPos)
    end

    Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(dt * SMOOTH, 0, 1))
end)


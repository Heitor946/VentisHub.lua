-- ============ HELPERS DE ALVO ===============================
-- ============================================================
local function GetRoot(model)
    if not model or not model:IsA("Model") then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return nil end
    return root
end

local function GetAim(model)
    local head = model:FindFirstChild("Head")
    if head then return head.Position end
    local root = GetRoot(model)
    return root and root.Position or nil
end

local function FindNearest()
    local char = Player.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local nearest, shortest = nil, MAX_DISTANCE
    local function check(m)
        local root = GetRoot(m)
        if not root then return end
        local d = (myRoot.Position - root.Position).Magnitude
        if d < shortest then shortest = d; nearest = m end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then check(p.Character) end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") and d ~= Player.Character
           and not Players:GetPlayerFromCharacter(d) then
            check(d)
        end
    end
    return nearest
end

local function SetTarget(model)
    Target = model
    Highlight.Adornee = model
    Highlight.Enabled = model ~= nil
    if model then
        ReticleGui.Adornee = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        ReticleGui.Enabled = true
    else
        ReticleGui.Adornee = nil
        ReticleGui.Enabled = false
    end
end

local function SetTransparency(alpha)
    local char = Player.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.LocalTransparencyModifier = alpha end
    end
end


local function Tween(obj, props, t, s, d)
    t = t or 0.22
    s = s or Enum.EasingStyle.Quad
    d = d or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(t, s, d), props):Play()
end


-- ============================================================
local function SetZoom(distance)
    CameraDistance = math.clamp(distance, ZOOM_MIN, ZOOM_MAX)
    ZoomLabel.Text = string.format("%dm", math.floor(CameraDistance + 0.5))
    local th = TH()
    Tween(ZoomLabel, { TextColor3 = th.btnOn }, 0.1)
    task.delay(0.15, function() Tween(ZoomLabel, { TextColor3 = th.txtIdle }, 0.25) end)
    local wantHidden = CameraDistance < 2.0
    if wantHidden ~= BodyHidden then
        BodyHidden = wantHidden
        SetTransparency(wantHidden and 1 or 0)
    end
end

local function ChangeZoom(delta) SetZoom(CameraDistance + delta) end


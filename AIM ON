local function UpdateEnableBtn()
    if LockOn then
        EnableLbl.Text = "LOCK: ON"
        EnableBtn.BackgroundColor3 = W95_GREEN
        EnableLbl.TextColor3 = W95_WHITE
    else
        EnableLbl.Text = "LOCK: OFF"
        EnableBtn.BackgroundColor3 = W95_BG
        EnableLbl.TextColor3 = W95_TEXT
    end
end

local function ToggleLockOn()
    if not LockOn then
        local t = FindNearest()
        if not t then
            warn("[Ventis] Nenhum alvo num raio de " .. MAX_DISTANCE)
            return
        end
        LockOn = true
        SetTarget(t)
        Player.CameraMode            = Enum.CameraMode.Classic
        Player.CameraMinZoomDistance = 0.5
        Player.CameraMaxZoomDistance = 400
        Camera.CameraType            = Enum.CameraType.Scriptable
        BodyHidden = CameraDistance < 2.0
        SetTransparency(BodyHidden and 1 or 0)
    else
        LockOn = false
        SetTarget(nil)
        Player.CameraMode            = Enum.CameraMode.Classic
        Player.CameraMinZoomDistance = 0.5
        Player.CameraMaxZoomDistance = 20
        Camera.CameraType            = Enum.CameraType.Custom
        SetTransparency(0)
        BodyHidden = false
    end
    UpdateEnableBtn()
end

local function SetZoom(d)
    CameraDistance = math.clamp(d, ZOOM_MIN, ZOOM_MAX)
    RowZoomTxt.Text = string.format("ZOOM: %dm", math.floor(CameraDistance + 0.5))
    local hide = CameraDistance < 2.0
    if hide ~= BodyHidden then
        BodyHidden = hide
        SetTransparency(hide and 1 or 0)
    end
end
local function ChangeZoom(d) SetZoom(CameraDistance + d) end


local function AddBevel(gui, raised)
    gui.BorderSizePixel = 0
    local topC = raised and W95_HIGHLIGHT or W95_DARK
    local botC = raised and W95_DARK or W95_HIGHLIGHT
    local z = (gui.ZIndex or 1) + 1
    local t = Instance.new("Frame", gui)
    t.Size = UDim2.new(1,0,0,1); t.BackgroundColor3 = topC
    t.BorderSizePixel = 0; t.ZIndex = z
    local l = Instance.new("Frame", gui)
    l.Size = UDim2.new(0,1,1,0); l.BackgroundColor3 = topC
    l.BorderSizePixel = 0; l.ZIndex = z
    local b = Instance.new("Frame", gui)
    b.Size = UDim2.new(1,0,0,1); b.Position = UDim2.new(0,0,1,-1)
    b.BackgroundColor3 = botC; b.BorderSizePixel = 0; b.ZIndex = z
    local r = Instance.new("Frame", gui)
    r.Size = UDim2.new(0,1,1,0); r.Position = UDim2.new(1,-1,0,0)
    r.BackgroundColor3 = botC; r.BorderSizePixel = 0; r.ZIndex = z
end

local function Sunken(parent, size, pos, bg)
    local f = Instance.new("Frame")
    f.Size = size; f.Position = pos
    f.BackgroundColor3 = bg or W95_WHITE
    f.BorderSizePixel = 0
    f.Parent = parent
    AddBevel(f, false)
    return f
end

local function W95Btn(parent, size, pos, text, fontSize, z)
    local b = Instance.new("TextButton")
    b.Size = size; b.Position = pos
    b.BackgroundColor3 = W95_BG
    b.Text = ""; b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = z or 6
    b.Parent = parent
    AddBevel(b, true)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-4,1,-4); lbl.Position = UDim2.new(0,2,0,2)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = fontSize or 14
    lbl.TextColor3 = W95_TEXT
    lbl.ZIndex = (z or 6) + 2
    lbl.Parent = b
    return b, lbl
end


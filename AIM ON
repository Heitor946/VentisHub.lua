local function BuildSouls(parent)
    local root = NewF(parent)
    local _, outerS = NewRing(root, 90, 3)
    local _, innerS = NewRing(root, 74, 1)
    local ticks = {
        NewBar(root, 4, 16, 0, -56), NewBar(root, 4, 16, 0, 56),
        NewBar(root, 16, 4, -56, 0), NewBar(root, 16, 4, 56, 0),
    }
    local dot = NewBar(root, 5, 5, 0, 0)
    return {
        root = root,
        applyColor = function(main, accent)
            outerS.Color = main; innerS.Color = accent
            for _, t in ipairs(ticks) do t.BackgroundColor3 = main end
            dot.BackgroundColor3 = main
        end,
        pulse = function(p)
            outerS.Transparency = 0.05 + p * 0.15
            innerS.Transparency = 0.5 + p * 0.3
        end,
    }
end

local function BuildDot(parent)
    local root = NewF(parent)
    local dot = NewBar(root, 6, 6, 0, 0)
    local dashes = {
        NewBar(root, 2, 8, 0, -20), NewBar(root, 2, 8, 0, 20),
        NewBar(root, 8, 2, -20, 0), NewBar(root, 8, 2, 20, 0),
    }
    return {
        root = root,
        applyColor = function(main)
            dot.BackgroundColor3 = main
            for _, d in ipairs(dashes) do d.BackgroundColor3 = main end
        end,
        pulse = function(p)
            dot.BackgroundTransparency = 0.1 + p * 0.3
        end,
    }
end

local function BuildDiamond(parent)
    local root = NewF(parent)
    local spinner = NewSpinner(root)
    local outer = NewF(spinner, UDim2.new(0, 70, 0, 70), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    outer.Rotation = 45
    Instance.new("UICorner", outer).CornerRadius = UDim.new(0, 6)
    local outerS = Instance.new("UIStroke", outer); outerS.Thickness = 3
    local inner = NewF(spinner, UDim2.new(0, 46, 0, 46), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    inner.Rotation = 45
    Instance.new("UICorner", inner).CornerRadius = UDim.new(0, 4)
    local innerS = Instance.new("UIStroke", inner); innerS.Thickness = 1
    local dots = {}
    for i = 1, 4 do
        local a = math.rad((i-1) * 90)
        table.insert(dots, NewBar(spinner, 4, 4, math.sin(a)*46, -math.cos(a)*46))
    end
    return {
        root = root,
        applyColor = function(main, accent)
            outerS.Color = main; innerS.Color = accent
            for _, d in ipairs(dots) do d.BackgroundColor3 = main end
        end,
        pulse = function(p) outerS.Transparency = 0.05 + p * 0.15 end,
        spin = function(a) spinner.Rotation = a end,
    }
end

local function BuildTriangle(parent)

local function NewF(parent, size, pos, anchor)
    local f = Instance.new("Frame")
    f.Size = size or UDim2.new(1, 0, 1, 0)
    f.Position = pos or UDim2.new(0, 0, 0, 0)
    f.AnchorPoint = anchor or Vector2.new(0, 0)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.Parent = parent
    return f
end

local function NewBar(parent, w, h, x, y, rot)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, w, 0, h)
    f.Position = UDim2.new(0.5, x, 0.5, y)
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BorderSizePixel = 0
    f.Rotation = rot or 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    return f
end

local function NewRing(parent, size, thickness)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, size, 0, size)
    f.Position = UDim2.new(0.5, 0, 0.5, 0)
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    local s = Instance.new("UIStroke", f)
    s.Thickness = thickness or 2
    return f, s
end

local function NewSpinner(parent)
    return NewF(parent, UDim2.new(1, 0, 1, 0), UDim2.new(0.5, 0, 0.5, 0), Vector2.new(0.5, 0.5))
end


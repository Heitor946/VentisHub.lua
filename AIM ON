local function NewF(parent, size, pos, anchor)
    local f = Instance.new("Frame")
    f.Size = size or UDim2.new(1,0,1,0)
    f.Position = pos or UDim2.new(0,0,0,0)
    f.AnchorPoint = anchor or Vector2.new(0,0)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.Parent = parent
    return f
end
local function NewBar(parent, w, h, x, y, rot)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,w,0,h)
    f.Position = UDim2.new(0.5,x,0.5,y)
    f.AnchorPoint = Vector2.new(0.5,0.5)
    f.BorderSizePixel = 0
    f.Rotation = rot or 0
    f.BackgroundColor3 = RET_COLOR
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(1,0)
    return f
end
local function NewRing(parent, size, thickness)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,size,0,size)
    f.Position = UDim2.new(0.5,0,0.5,0)
    f.AnchorPoint = Vector2.new(0.5,0.5)
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(1,0)
    local s = Instance.new("UIStroke", f)
    s.Thickness = thickness or 2
    s.Color = RET_COLOR
    return f, s
end
local function NewSpinner(parent)
    return NewF(parent, UDim2.new(1,0,1,0), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
end

local function BuildSouls(p)
    local root = NewF(p)
    local _, s1 = NewRing(root, 90, 3)
    local _, s2 = NewRing(root, 74, 1); s2.Color = RET_ACCENT
    NewBar(root,4,16,0,-56); NewBar(root,4,16,0,56)
    NewBar(root,16,4,-56,0); NewBar(root,16,4,56,0)
    NewBar(root,5,5,0,0)
    return { root=root, pulse=function(pl)
        s1.Transparency = 0.05 + pl*0.15
        s2.Transparency = 0.5  + pl*0.3
    end }
end
local function BuildDot(p)
    local root = NewF(p)
    local dot = NewBar(root,6,6,0,0)
    NewBar(root,2,8,0,-20); NewBar(root,2,8,0,20)
    NewBar(root,8,2,-20,0); NewBar(root,8,2,20,0)
    return { root=root, pulse=function(pl) dot.BackgroundTransparency = 0.1 + pl*0.3 end }
end
local function BuildCross(p)
    local root = NewF(p)
    NewBar(root,4,4,0,0)
    local b = { NewBar(root,2,16,0,-14), NewBar(root,2,16,0,14),
                NewBar(root,16,2,-14,0), NewBar(root,16,2,14,0) }
    return { root=root, pulse=function(pl) for _,x in ipairs(b) do x.BackgroundTransparency = pl*0.3 end end }
end
local function BuildDiamond(p)
    local root = NewF(p)
    local sp = NewSpinner(root)
    local o = NewF(sp, UDim2.new(0,70,0,70), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    o.Rotation = 45
    Instance.new("UICorner", o).CornerRadius = UDim.new(0,6)
    local os = Instance.new("UIStroke", o); os.Thickness = 3; os.Color = RET_COLOR
    local i = NewF(sp, UDim2.new(0,46,0,46), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    i.Rotation = 45
    Instance.new("UICorner", i).CornerRadius = UDim.new(0,4)
    local is_ = Instance.new("UIStroke", i); is_.Thickness = 1; is_.Color = RET_ACCENT
    return { root=root, pulse=function(pl) os.Transparency = 0.05 + pl*0.15 end,
             spin=function(a) sp.Rotation = a end }
end
local function BuildTriangle(p)
    local root = NewF(p)
    local sp = NewSpinner(root)
    local ticks = {}
    for i = 1, 3 do
        local a = (i-1)*120
        local r = math.rad(a)
        ticks[i] = NewBar(sp, 5, 20, math.sin(r)*50, -math.cos(r)*50, a)
    end
    NewBar(sp, 4, 4, 0, 0)
    return { root=root, pulse=function(pl) for _,t in ipairs(ticks) do t.BackgroundTransparency = pl*0.3 end end,
             spin=function(a) sp.Rotation = a end }
end
local function BuildHexagon(p)
    local root = NewF(p)
    local sp = NewSpinner(root)
    local ticks = {}
    for i = 1, 6 do
        local a = (i-1)*60
        local r = math.rad(a)
        ticks[i] = NewBar(sp, 4, 14, math.sin(r)*48, -math.cos(r)*48, a)
    end
    return { root=root, pulse=function(pl) for _,t in ipairs(ticks) do t.BackgroundTransparency = pl*0.3 end end,
             spin=function(a) sp.Rotation = a end }
end
local function BuildSquare(p)
    local root = NewF(p)
    local o = NewF(root, UDim2.new(0,80,0,80), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    Instance.new("UICorner", o).CornerRadius = UDim.new(0,4)
    local os = Instance.new("UIStroke", o); os.Thickness = 3; os.Color = RET_COLOR
    local i = NewF(root, UDim2.new(0,60,0,60), UDim2.new(0.5,0,0.5,0), Vector2.new(0.5,0.5))
    Instance.new("UICorner", i).CornerRadius = UDim.new(0,3)
    local is_ = Instance.new("UIStroke", i); is_.Thickness = 1; is_.Color = RET_ACCENT
    NewBar(root, 4, 4, 0, 0)
    return { root=root, pulse=function(pl)
        os.Transparency = 0.05 + pl*0.15
        is_.Transparency = 0.5 + pl*0.3
    end }
end
local function BuildChevron(p)
    local root = NewF(p)
    local l = NewBar(root,4,18,-6,-6,-30)
    local r = NewBar(root,4,18, 6,-6, 30)
    NewBar(root,4,4,0,14)
    return { root=root, pulse=function(pl)
        l.BackgroundTransparency = pl*0.3
        r.BackgroundTransparency = pl*0.3
    end }
end
local function BuildBracket(p)
    local root = NewF(p)
    local d, len, th = 32, 12, 3
    local bars = {
        NewBar(root,th,len,-d,-d+len/2-2), NewBar(root,len,th,-d+len/2-2,-d),
        NewBar(root,th,len,d,-d+len/2-2),  NewBar(root,len,th,d-len/2+2,-d),
        NewBar(root,th,len,-d,d-len/2+2),  NewBar(root,len,th,-d+len/2-2,d),
        NewBar(root,th,len,d,d-len/2+2),   NewBar(root,len,th,d-len/2+2,d),
    }
    NewBar(root,4,4,0,0)
    return { root=root, pulse=function(pl) for _,b in ipairs(bars) do b.BackgroundTransparency = pl*0.25 end end }
end
local function BuildStar(p)
    local root = NewF(p)
    local sp = NewSpinner(root)
    local ticks = {}
    for i = 1, 5 do
        local a = (i-1)*72
        local r = math.rad(a)
        ticks[i] = NewBar(sp, 4, 16, math.sin(r)*45, -math.cos(r)*45, a)
    end
    NewBar(sp, 5, 5, 0, 0)
    return { root=root, pulse=function(pl) for _,t in ipairs(ticks) do t.BackgroundTransparency = pl*0.3 end end,
             spin=function(a) sp.Rotation = -a*0.6 end }
end
local function BuildSpinner(p)
    local root = NewF(p)
    local sp = NewSpinner(root)
    local lengths = { 18, 12, 18, 12 }
    for i = 1, 4 do
        local a = (i-1)*90
        local r = math.rad(a)
        local rad = 40 + lengths[i]
        NewBar(sp, 3, lengths[i], math.sin(r)*rad, -math.cos(r)*rad, a)
    end
    NewBar(sp, 4, 4, 0, 0)
    return { root=root, pulse=function() end, spin=function(a) sp.Rotation = a*2 end }
end
local function BuildTarget(p)
    local root = NewF(p)
    local _, r1 = NewRing(root, 90, 2)
    local _, r2 = NewRing(root, 60, 2); r2.Color = RET_ACCENT
    local _, r3 = NewRing(root, 30, 2)
    NewBar(root, 6, 6, 0, 0)
    return { root=root, pulse=function(pl)
        r1.Transparency = 0.3 + pl*0.2
        r2.Transparency = 0.3 + pl*0.2
        r3.Transparency = 0.3 + pl*0.2
    end }
end


local function BuildBracket(parent)
    local root = NewF(parent)
    local d, len, th = 32, 12, 3
    local bars = {
        NewBar(root, th, len, -d, -d + len/2 - 2),
        NewBar(root, len, th, -d + len/2 - 2, -d),
        NewBar(root, th, len, d, -d + len/2 - 2),
        NewBar(root, len, th, d - len/2 + 2, -d),
        NewBar(root, th, len, -d, d - len/2 + 2),
        NewBar(root, len, th, -d + len/2 - 2, d),
        NewBar(root, th, len, d, d - len/2 + 2),
        NewBar(root, len, th, d - len/2 + 2, d),
    }
    local dot = NewBar(root, 4, 4, 0, 0)
    return {
        root = root,
        applyColor = function(main)
            for _, b in ipairs(bars) do b.BackgroundColor3 = main end
            dot.BackgroundColor3 = main
        end,
        pulse = function(p)
            for _, b in ipairs(bars) do b.BackgroundTransparency = p * 0.25 end
        end,
    }
end

local function BuildStar(parent)
    local root = NewF(parent)
    local spinner = NewSpinner(root)
    local ticks = {}
    for i = 1, 5 do
        local a = (i-1) * 72
        local r = math.rad(a)
        table.insert(ticks, NewBar(spinner, 4, 16, math.sin(r)*45, -math.cos(r)*45, a))
    end
    local dot = NewBar(spinner, 5, 5, 0, 0)
    return {
        root = root,
        applyColor = function(main)
            for _, t in ipairs(ticks) do t.BackgroundColor3 = main end
            dot.BackgroundColor3 = main
        end,
        pulse = function(p)
            for _, t in ipairs(ticks) do t.BackgroundTransparency = p * 0.3 end
        end,
        spin = function(a) spinner.Rotation = -a * 0.6 end,
    }
end

local function BuildSpinner(parent)
    local root = NewF(parent)
    local spinner = NewSpinner(root)
    local ticks = {}
    local lengths = { 18, 12, 18, 12 }
    for i = 1, 4 do
        local a = (i-1) * 90
        local r = math.rad(a)
        local rad = 40 + lengths[i]
        table.insert(ticks, NewBar(spinner, 3, lengths[i], math.sin(r)*rad, -math.cos(r)*rad, a))
    end
    local dot = NewBar(spinner, 4, 4, 0, 0)
    return {
        root = root,
        applyColor = function(main)
            for _, t in ipairs(ticks) do t.BackgroundColor3 = main end
            dot.BackgroundColor3 = main
        end,
        pulse = function(p) end,
        spin = function(a) spinner.Rotation = a * 2 end,
    }
end

local function BuildTarget(parent)
    local root = NewF(parent)
    local _, r1 = NewRing(root, 90, 2)
    local _, r2 = NewRing(root, 60, 2)
    local _, r3 = NewRing(root, 30, 2)
    local dot = NewBar(root, 6, 6, 0, 0)
    return {
        root = root,
        applyColor = function(main, accent)
            r1.Color = main; r2.Color = accent; r3.Color = main
            dot.BackgroundColor3 = main
        end,
        pulse = function(p)
            r1.Transparency = 0.3 + p * 0.2
            r2.Transparency = 0.3 + p * 0.2
            r3.Transparency = 0.3 + p * 0.2
        end,
    }
end


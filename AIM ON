-- ============================================================
local function ToggleLockOn()
    local th = TH()
    if not LockOn then
        local t = FindNearest()
        if not t then
            warn("[Ventis] Nenhum alvo num raio de " .. MAX_DISTANCE)
            Tween(Button, { BackgroundColor3 = Color3.fromRGB(120,40,40) }, 0.1)
            task.delay(0.15, function() Tween(Button, { BackgroundColor3 = th.btnIdle }, 0.25) end)
            return
        end
        LockOn = true
        SetTarget(t)
        Player.CameraMode            = Enum.CameraMode.Classic
        Player.CameraMinZoomDistance = 0.5
        Player.CameraMaxZoomDistance = 400
        Camera.CameraType            = Enum.CameraType.Scriptable
        BodyHidden = CameraDistance < 2.0
        SetTransparency(BodyHidden and 1 or 0)
    else
        LockOn = false
        SetTarget(nil)
        Player.CameraMode            = Enum.CameraMode.Classic
        Player.CameraMinZoomDistance = 0.5
        Player.CameraMaxZoomDistance = 20
        Camera.CameraType            = Enum.CameraType.Custom
        SetTransparency(0)
        BodyHidden = false
    end
    if LockOn then
        Button.Text = "LOCK ON\nON"
        Tween(Button, { BackgroundColor3 = th.btnOn, TextColor3 = th.txtOn }, 0.25)
    else
        Button.Text = "LOCK ON\nOFF"
        Tween(Button, { BackgroundColor3 = th.btnIdle, TextColor3 = th.txtIdle }, 0.25)
    end
end


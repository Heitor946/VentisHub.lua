    local dot = NewBar(spinner, 4, 4, 0, 0)
    return {
        root = root,
        applyColor = function(main)
            for _, t in ipairs(ticks) do t.BackgroundColor3 = main end
            dot.BackgroundColor3 = main
        end,
        pulse = function(p)
            for _, t in ipairs(ticks) do t.BackgroundTransparency = p * 0.3 end
        end,
        spin = function(a) spinner.Rotation = a end,
    }
end


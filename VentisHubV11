local Frames = 0
local LastFPS = os.clock()

RunService.RenderStepped:Connect(function()

    -- FPS
    Frames += 1

    local Now = os.clock()

    if Now-LastFPS >= 1 then

        FPS.Text =
            "FPS: "..Frames

        Frames = 0
        LastFPS = Now

    end

    -- MOVEMENT
    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character and
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then

        if Config.WalkSpeed then
            Humanoid.WalkSpeed =
                Config.Speed
        end

        if Config.JumpPower then
            Humanoid.JumpPower =
                Config.Jump
        end

    end

    -- VISUAL
    local Camera =
        workspace.CurrentCamera

    for player,data in pairs(ESPObjects) do

        local Character =
            player.Character

        local Humanoid =
            Character and
            Character:FindFirstChildOfClass(
                "Humanoid"
            )

        local Root =
            Character and
            Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if Humanoid
            and Root
            and Humanoid.Health > 0 then

            data.Highlight.Enabled =
                Config.WallHighlight

            data.Billboard.Enabled =
                Config.ESP

            local Distance =
                (
                    Camera.CFrame.Position
                    -Root.Position
                ).Magnitude

            data.Label.Text =
                player.Name ..
                " • " ..
                math.floor(Distance)

            if Config.Tracers then

                local Position, Visible =
                    Camera:WorldToViewportPoint(
                        Root.Position
                    )

                if Visible and Position.Z > 0 then

                    local Viewport =
                        Camera.ViewportSize

                    local Start =
                        Vector2.new(
                            Viewport.X/2,
                            Viewport.Y
                        )

                    local Finish =
                        Vector2.new(
                            Position.X,
                            Position.Y
                        )

                    local Difference =
                        Finish-Start

                    local Length =
                        Difference.Magnitude

                    if Length > 1 then

                        local Middle =
                            (Start+Finish)/2

                        data.Tracer.Position =
                            UDim2.fromOffset(
                                Middle.X,
                                Middle.Y
                            )

                        data.Tracer.Size =
                            UDim2.fromOffset(
                                Length,
                                2
                            )

                        data.Tracer.Rotation =
                            math.deg(
                                math.atan2(
                                    Difference.Y,
                                    Difference.X
                                )
                            )

                        data.Tracer.Visible = true

                    end

                else
                    data.Tracer.Visible = false
                end

            else
                data.Tracer.Visible = false
            end

        else

            data.Highlight.Enabled = false
            data.Billboard.Enabled = false
            data.Tracer.Visible = false

        end
    end

    -- AIM
    if Config.AimAssist then

        FOVCircle.Visible =
            Config.FOVEnabled

        if LockedTarget
            and not ValidTarget(
                LockedTarget
            ) then

            LockedTarget = nil
        end

        if not LockedTarget then
            LockedTarget = GetTarget()
        end

        if LockedTarget then
            AimAt(LockedTarget)
        end

    else

        LockedTarget = nil
        FOVCircle.Visible = false

    end

end)


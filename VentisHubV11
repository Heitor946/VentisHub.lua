local function Toggle(text, state, callback)

    local B

    local function Update()

        B.Text =
            text ..
            "   [" ..
            (state and "ON" or "OFF") ..
            "]"

        B.TextColor3 =
            state
            and Color3.fromRGB(255,75,75)
            or Color3.fromRGB(235,235,240)

    end

    B = Button("",function()

        state = not state

        callback(state)

        Update()

    end)

    Update()

    return B
end


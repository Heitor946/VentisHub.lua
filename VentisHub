local function fadeAndRun()
    TweenService:Create(keyScreen, TWEEN_MED, {BackgroundTransparency = 1}):Play()
    for _, d in ipairs(keyScreen:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextBox") then
            TweenService:Create(d, TWEEN_MED, {TextTransparency = 1}):Play()
        elseif d:IsA("Frame") then
            TweenService:Create(d, TWEEN_MED, {BackgroundTransparency = 1}):Play()
        elseif d:IsA("UIStroke") then
            TweenService:Create(d, TWEEN_MED, {Transparency = 1}):Play()
        end
    end
    task.wait(0.35)
    keyScreen:Destroy()
    if gui then gui:Destroy() end

    local remote = fetchRemote(CONFIG.PAID_SCRIPT_URL)
    if remote then
        runScript(remote, "Premium")
    else
        warn("⚡ VENTIS: falha ao baixar o script do GitHub. Verifique a URL.")
    end
end


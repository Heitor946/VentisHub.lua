local SavedEffects = {}

local function EnableAntiLag()
    SavedEffects = {}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then
            SavedEffects[obj] = obj.Enabled
            obj.Enabled = false
        end
    end
end

local function DisableAntiLag()
    for obj,value in pairs(SavedEffects) do
        if obj and obj.Parent then
            pcall(function()
                obj.Enabled = value
            end)
        end
    end
    SavedEffects = {}
end

CreateToggle("Anti-Lag",false,function(value)
    Config.AntiLag = value
    if value then
        EnableAntiLag()
    else
        DisableAntiLag()
    end
end)


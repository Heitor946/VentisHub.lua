local function CreateToggle(text, default, callback)
    local state = default
    local button

    local function update()
        button.Text = text .. "  [" .. (state and "ON" or "OFF") .. "]"
        button.TextColor3 = state
            and Color3.fromRGB(255,75,75)
            or Color3.fromRGB(235,235,235)
    end

    button = CreateButton("", function()
        state = not state
        callback(state)
        update()
    end)

    update()
    return button
end

local function CreateSlider(text, minimum, maximum, default, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1,-3,0,57)
    holder.BackgroundColor3 = Color3.fromRGB(28,28,32)
    holder.BorderSizePixel = 0

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8); c.Parent = p; return c
end

local function stroke(p, color, thick, transp)
    local s = Instance.new("UIStroke")
    s.Color = color or THEME.border
    s.Thickness = thick or 1
    s.Transparency = transp or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p; return s
end

local function gradient(p, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2)
    g.Rotation = rot or 0
    g.Parent = p; return g
end

local function safeWrite(name, data)
    pcall(function() writefile(name, data) end)
end
local function safeRead(name)
    local ok, data = pcall(function() return readfile(name) end)
    return ok and data or nil
end

-- ============================================================
-- ▓▓▓  VALIDAÇÃO  ▓▓▓
-- ============================================================

local function validateKeyHTTP(key)
    if CONFIG.VALIDATE_URL == "" then return nil end
    local url = CONFIG.VALIDATE_URL .. "?key=" .. key
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or not res then return false end
    return tostring(res):lower():find("valid") ~= nil
end

local function validateKeyLocal(key)
    return CONFIG.VALID_KEYS[key] == true
end

local function validateKey(key)
    if type(key) ~= "string" or #key < 4 then return false end
    local httpResult = validateKeyHTTP(key)
    if httpResult ~= nil then return httpResult end
    return validateKeyLocal(key)
end

-- ============================================================
-- ▓▓▓  EXECUÇÃO  ▓▓▓
-- ============================================================

local function fetchRemote(url)
    if not url or url == "" then return nil end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res and #res > 0 then return res end
    return nil
end

local function runScript(code, label)
    if not code or #code < 4 then
        warn("⚡ VENTIS: script vazio — " .. label); return false
    end
    local fn, err = loadstring(code)
    if not fn then
        warn("⚡ VENTIS: erro no " .. label .. " → " .. tostring(err))
        return false
    end
    local ok, err2 = pcall(fn)
    if not ok then
        warn("⚡ VENTIS: falha na execução → " .. tostring(err2))
        return false
    end
    print("⚡ VENTIS: " .. label .. " iniciado com sucesso.")
    return true
end


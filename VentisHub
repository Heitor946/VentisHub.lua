    task.wait(0.6)

    if validateKey(key) then
        statusLabel.Text = "✓ Key válida! Bem-vindo ao Premium."
        statusLabel.TextColor3 = THEME.success
        activateLabel.Text = "✓ ATIVADO"
        inputStroke.Color = THEME.success
        safeWrite(CONFIG.KEY_FILE, key)
        task.wait(0.9)
        fadeAndRun()
    else
        statusLabel.Text = "✗ Key inválida. Verifique e tente novamente."
        statusLabel.TextColor3 = THEME.danger
        activateLabel.Text = "ATIVAR"
        inputStroke.Color = THEME.danger
        task.wait(1.5)
        inputStroke.Color = THEME.border
    end
end)

